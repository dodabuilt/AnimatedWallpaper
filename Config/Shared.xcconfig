// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = AnimatedWallpaper
PRODUCT_DISPLAY_NAME = Animated Wallpaper
PRODUCT_BUNDLE_IDENTIFIER = com.dash.animatedwallpaper
MARKETING_VERSION = 1.0.1
CURRENT_PROJECT_VERSION = 2

// ==========================================
// Creator Info
// ==========================================
INFOPLIST_KEY_NSHumanReadableCopyright = © 2026 David Medvedev. All rights reserved.

// ==========================================
// Platform Configuration
// ==========================================
MACOSX_DEPLOYMENT_TARGET = 13.0

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_LSUIElement = YES
INFOPLIST_KEY_NSHighResolutionCapable = YES

// ==========================================
// App Icon
// ==========================================
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GENERATE_ASSET_SYMBOLS = NO

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/AnimatedWallpaper.entitlements to add capabilities
CODE_SIGN_ENTITLEMENTS = Config/AnimatedWallpaper.entitlements